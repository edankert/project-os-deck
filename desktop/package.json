{
  "name": "project-os-deck-desktop",
  "productName": "Deck",
  "version": "0.1.0",
  "private": true,
  "description": "Deck: an Electron shell and a served read-only host over one renderer, reading project-os-cockpit's sidecar (PHASE-0001).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.web.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "npm run build && electron .",
    "start:lan": "npm run build && electron . --lan",
    "test": "npm run build && node --test --test-timeout 30000 tests/*.test.mjs",
    "smoke": "npm run build && electron . --smoke",
    "measure": "npm run build && electron . --measure",
    "smoke:lan": "npm run build && electron . --smoke --lan"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^32.0.0",
    "typescript": "^5.4.0"
  }
}
